---
import {COLOURS, toHex} from './colour'
---
<details>
	<summary>Palette</summary>
	<ul>
		{COLOURS.map(([name, colour]) => (
			<li>
				<button
					onclick={`colour_input.value += '${name.charAt(0)}'`}
					style={`background: ${toHex(colour)}; color: contrast-color(${toHex(colour)})`}
				>
					<u>{name.charAt(0)}</u>{name.slice(1)}
				</button>
			</li>
		))}
	</ul>
</details>

<style>
	ul, li
	{
		list-style: none;
		padding: 0;
		margin: 0;
	}

	button
	{
		cursor: pointer;
		width: 10ch;
		border: none;
		margin: 0;
		padding: 4px;
	}
</style>
