---
interface Props {
	colour?: string
}
---
<div>
	<label for="colour_input">Colour</label>
	<input
		id="colour_input"
		placeholder="ex: YYR"
		value={Astro.props.colour}
		type="text"
		name="colour"
		aria-describedby="palette"
		autofocus="true"
		autocomplete="off"
		autocorrect="off"
		spellcheck="false"
	/>
	<button type="submit">Mix</button>
</div>
<script>
	import {reduce, mix, toHex, getWeights} from './colour'
	
	const input = document.getElementById('colour_input')
	const preview = document.getElementById('colour_preview')
	const code = document.getElementById('hex_code')

	function dynamicallyUpdate(event: Event) {
		// @ts-ignore
		const colour = event.target.value
		const reduced = reduce(colour)
    	history.replaceState(null, '', `/${reduced}`)

		const hex = toHex(mix(reduced))
		preview.style.background = hex
		code.innerText = hex

		const charWidth = 1.4
		const stops = getWeights(colour + 'x') // include dummy character at end to cut off gradient
			.map((w) => (w) ? toHex(w) : 'transparent')
			.map((hex, i) => `,\n${hex} ${i * charWidth}ch, ${hex} ${(i + 1) * charWidth}ch`)
			.join('')

		input.style.background = `linear-gradient(to right ${stops})`
	}

  	input.addEventListener('input', dynamicallyUpdate)
	window.addEventListener('DOMContentLoaded', () => dynamicallyUpdate({target: input} as unknown as Event))
</script>
<style>
	label
	{
		clip: rect(0 0 0 0); 
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap; 
		width: 1px;
	}

	input
	{
		text-transform: uppercase;
		font-family: monospace;
		font-size: 16px;
		/* font-weight: bold; */
		letter-spacing: 0.4ch;
		line-height: 28px;
		padding: 0 0.2ch;
		border-radius: 0;
		border: 1px solid black;
		outline: none;
		flex: 1;

		color: black;
		-webkit-text-stroke: 2px white;
		paint-order: stroke fill;

		&:focus
		{
			border-color: rgb(0, 132, 255);
		}
	}

	button
	{
		font-size: 16px;
		line-height: 28px;
		border-radius: 0;
		border: 1px solid black;
		outline: none;
		padding: 0 2ch;
		background: black;
		color: white;
	}

	div
	{
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 8px 0;
	}
</style>
