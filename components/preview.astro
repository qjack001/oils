---
interface Props {
	hex?: string
}

const {hex} = Astro.props
---
<output
	id="colour_preview"
	for="colour_input"
	aria-label="Colour preview"
	style=`background: ${hex}`
>
	<button
		type="button"
		aria-label="Click to copy hex code"
		onclick=`navigator.clipboard.writeText('${hex}')`
	>
		<code id="hex_code">{hex}</code>
	</button>
</output>

<style>
	output
	{
		display: flex;
		width: 100%;
		height: 30vh;
		border: 1px solid black;
		padding: 0;
		margin: 0;

		justify-content: center;
		align-items: center;
	}

	button
	{
		cursor: pointer;
		background: white;
		color: black;
		border: 1px solid black;
		mix-blend-mode: exclusion;
	}
</style>
