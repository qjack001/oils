---
import {reduce, mix, toHex, isZorn} from '../components/colour'
import Input from '../components/input.astro'
import Palette from '../components/palette.astro'
import Preview from '../components/preview.astro'
import Zorn from '../components/zorn.astro'

// non-JS form submissions will pass it as a query param
const param = Astro.url.searchParams.get('colour')
const colour = reduce(param || Astro.params.colour)

if (colour != Astro.params.colour) {
	return new Response(null, {
		status: 303,
		headers: {Location: `/${colour}`},
	})
}

const hex = toHex(mix(colour))
---

<form action="/generate" method="GET">
	<Preview id="d" hex={hex}/>
	<Input colour={colour}/>
</form>
<Palette/>
{isZorn(colour) && <Zorn/>}

