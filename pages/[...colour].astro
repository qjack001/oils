---
import {reduce, mix, toHex, isZorn} from '../components/colour'
import {processPost} from '../components/form'
import Base from '../components/base.astro'
import Input from '../components/input.astro'
import Palette from '../components/palette.astro'
import Preview from '../components/preview.astro'
import Zorn from '../components/zorn.astro'


const urlColour = Astro.params.colour || ''
const formColour = await processPost(Astro.request)

const colour = reduce(formColour || urlColour)

if (colour != urlColour) {
	return new Response(null, {
		status: 303,
		headers: {Location: `/${colour}`},
	})
}

const hex = toHex(mix(colour))
---
<Base>
	<form action="/" method="POST">
		<Preview hex={hex}/>
		<Input colour={colour}/>
	</form>
	<Palette/>
	{isZorn(colour) && <Zorn/>}
</Base>
